{
  "id": "yanuo.display-desktop",
  "kind": "service",
  "name": {
    "zh-Hans": "桌面显示",
    "zh-Hant": "桌面顯示",
    "ja": "デスクトップ表示",
    "en": "Desktop display",
    "ko": "데스크톱 표시"
  },
  "description": {
    "zh-Hans": "开发用：把每块打开的面板显示成一个普通窗口",
    "en": "For development: shows every open panel as a normal window"
  },
  "version": "1.0.0",
  "author": "yanuo",
  "license": "MIT",
  "provides": [
    "panels"
  ],
  "main": "main.js",
  "config": {
    "type": "object",
    "dict": {
      "quick1": {
        "type": "string",
        "meta": {
          "description": {
            "zh-Hans": "快捷面板 1",
            "en": "Quick panel 1"
          },
          "hint": {
            "zh-Hans": "写那块面板的组件 id，留空就是空位",
            "en": "The component id of that panel; empty leaves the slot unused"
          },
          "default": "yanuo.shell-classic"
        }
      },
      "quick2": {
        "type": "string",
        "meta": {
          "description": {
            "zh-Hans": "快捷面板 2",
            "en": "Quick panel 2"
          },
          "hint": {
            "zh-Hans": "写那块面板的组件 id，留空就是空位",
            "en": "The component id of that panel; empty leaves the slot unused"
          },
          "default": ""
        }
      },
      "limit": {
        "type": "number",
        "meta": {
          "description": {
            "zh-Hans": "同时显示的面板数",
            "en": "Panels shown at once"
          },
          "hint": {
            "zh-Hans": "打开着的面板多过这个数时，只显示组件顺序靠前的",
            "en": "When more panels are open than this, only the ones earlier in the component order are shown"
          },
          "default": 8,
          "min": 4,
          "max": 12,
          "step": 1
        }
      }
    }
  }
}
