{
  "id": "yanuo.aliyun",
  "kind": "service",
  "name": {
    "zh-Hans": "阿里云",
    "zh-Hant": "阿里雲",
    "ja": "Alibaba Cloud",
    "en": "Alibaba Cloud",
    "ko": "Alibaba Cloud"
  },
  "description": {
    "zh-Hans": "本服务提供阿里云密钥封装能力",
    "zh-Hant": "本服務提供阿里雲金鑰封裝能力",
    "ja": "他のコンポーネントに Alibaba Cloud のキーを提供するサービス",
    "en": "Wraps the Alibaba Cloud key for other components",
    "ko": "다른 컴포넌트에 Alibaba Cloud 키를 제공하는 서비스"
  },
  "version": "1.3.6",
  "author": "yanuo",
  "license": "MIT",
  "provides": [
    "aliyun",
    "usage"
  ],
  "window": "window.js",
  "main": "main.js",
  "config": {
    "type": "object",
    "dict": {
      "apiKey": {
        "type": "string",
        "meta": {
          "description": "API Key",
          "hint": {
            "zh-Hans": "百炼服务连接密钥",
            "zh-Hant": "百煉服務連線金鑰",
            "ja": "Bailian サービスの接続キー",
            "en": "Key for connecting to the Bailian service",
            "ko": "Bailian 서비스 연결 키"
          },
          "role": "secret",
          "share": "aliyun-bailian"
        }
      },
      "domain": {
        "type": "string",
        "meta": {
          "description": {
            "zh-Hans": "接入域名",
            "zh-Hant": "接入網域",
            "ja": "接続ドメイン",
            "en": "Endpoint domain",
            "ko": "접속 도메인"
          },
          "hint": {
            "zh-Hans": "百炼服务专属连接地址",
            "zh-Hant": "百煉服務專屬連線位址",
            "ja": "Bailian サービス専用の接続先",
            "en": "Dedicated endpoint for the Bailian service",
            "ko": "Bailian 서비스 전용 접속 주소"
          },
          "default": "dashscope.aliyuncs.com"
        }
      }
    }
  }
}
