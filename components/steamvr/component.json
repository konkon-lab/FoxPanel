{
  "id": "yanuo.steamvr",
  "kind": "service",
  "name": {
    "zh-Hans": "SteamVR",
    "zh-Hant": "SteamVR",
    "ja": "SteamVR",
    "en": "SteamVR",
    "ko": "SteamVR"
  },
  "description": {
    "zh-Hans": "在 SteamVR 里把面板显示成悬浮窗口：手柄指着点击、握住移动、双手缩放，手柄键收起和恢复",
    "zh-Hant": "在 SteamVR 裡把面板顯示成懸浮視窗：手把指著點擊、握住移動、雙手縮放，手把鍵收起和恢復",
    "ja": "SteamVR でパネルをオーバーレイとして表示：コントローラーで指してクリック、握って移動、両手で拡大縮小、ボタンで収納と復元",
    "en": "Shows panels as overlays in SteamVR: point and click with controllers, grip to move, both hands to scale, a button to stow and restore",
    "ko": "SteamVR에서 패널을 오버레이로 표시: 컨트롤러로 가리켜 클릭, 잡아서 이동, 양손으로 크기 조절, 버튼으로 넣기와 복원"
  },
  "version": "1.0.13",
  "author": "yanuo",
  "license": "MIT",
  "provides": [
    "panels"
  ],
  "main": "main.js",
  "process": "own",
  "config": {
    "type": "intersect",
    "list": [
      {
        "type": "object",
        "dict": {
          "quick1": {
            "type": "string",
            "meta": {
              "description": {
                "zh-Hans": "快捷面板 1",
                "zh-Hant": "快捷面板 1",
                "ja": "クイックパネル 1",
                "en": "Quick panel 1",
                "ko": "빠른 패널 1"
              },
              "hint": {
                "zh-Hans": "写那块面板的组件 id，留空就是不用这个键",
                "zh-Hant": "填那塊面板的元件 id，留空就是不用這個鍵",
                "ja": "そのパネルのコンポーネント ID を入力します。空欄ならこのボタンは使いません",
                "en": "Enter the component id of that panel. Leave empty to leave this button unused",
                "ko": "해당 패널의 컴포넌트 ID를 입력합니다. 비워 두면 이 버튼을 쓰지 않습니다"
              },
              "default": "yanuo.shell-classic"
            }
          },
          "quick2": {
            "type": "string",
            "meta": {
              "description": {
                "zh-Hans": "快捷面板 2",
                "zh-Hant": "快捷面板 2",
                "ja": "クイックパネル 2",
                "en": "Quick panel 2",
                "ko": "빠른 패널 2"
              },
              "hint": {
                "zh-Hans": "写那块面板的组件 id，留空就是不用这个键",
                "zh-Hant": "填那塊面板的元件 id，留空就是不用這個鍵",
                "ja": "そのパネルのコンポーネント ID を入力します。空欄ならこのボタンは使いません",
                "en": "Enter the component id of that panel. Leave empty to leave this button unused",
                "ko": "해당 패널의 컴포넌트 ID를 입력합니다. 비워 두면 이 버튼을 쓰지 않습니다"
              },
              "default": ""
            }
          },
          "limit": {
            "type": "number",
            "meta": {
              "description": {
                "zh-Hans": "同时显示的面板数",
                "zh-Hant": "同時顯示的面板數",
                "ja": "同時に表示するパネル数",
                "en": "Panels shown at once",
                "ko": "동시에 표시할 패널 수"
              },
              "hint": {
                "zh-Hans": "打开着的面板多过这个数时，只显示组件顺序靠前的",
                "zh-Hant": "開啟著的面板多過這個數時，只顯示元件順序靠前的",
                "ja": "開いているパネルがこの数を超えると、コンポーネントの順序が前のものだけ表示します",
                "en": "When more panels are open than this, only the ones earlier in the component order are shown",
                "ko": "열려 있는 패널이 이 수보다 많으면 컴포넌트 순서가 앞선 것만 표시합니다"
              },
              "default": 8,
              "min": 4,
              "max": 12,
              "step": 1
            }
          },
          "recenter": {
            "type": "union",
            "list": [
              {
                "type": "const",
                "value": "never",
                "meta": {
                  "description": {
                    "zh-Hans": "不动",
                    "zh-Hant": "不動",
                    "ja": "動かさない",
                    "en": "Leave in place",
                    "ko": "그대로 두기"
                  }
                }
              },
              {
                "type": "const",
                "value": "away",
                "meta": {
                  "description": {
                    "zh-Hans": "只拉回不在面前的",
                    "zh-Hant": "只拉回不在面前的",
                    "ja": "手前にないものだけ戻す",
                    "en": "Bring back if out of reach",
                    "ko": "앞에 없는 것만 가져오기"
                  }
                }
              },
              {
                "type": "const",
                "value": "always",
                "meta": {
                  "description": {
                    "zh-Hans": "每次重排",
                    "zh-Hant": "每次重排",
                    "ja": "毎回並べ直す",
                    "en": "Rearrange every time",
                    "ko": "매번 다시 배치"
                  }
                }
              }
            ],
            "meta": {
              "description": {
                "zh-Hans": "显示面板时的摆放",
                "zh-Hant": "顯示面板時的擺放",
                "ja": "パネル表示時の配置",
                "en": "Placement when a panel appears",
                "ko": "패널을 표시할 때의 배치"
              },
              "hint": {
                "zh-Hans": "面板重新显示出来时放在哪：留在上次的位置，或者放回面前",
                "zh-Hant": "面板重新顯示出來時放在哪：留在上次的位置，或者放回面前",
                "ja": "パネルを再表示するときの位置：前回の位置のままにするか、手前に戻します",
                "en": "Where a panel goes when it is shown again: its last position, or back in front of you",
                "ko": "패널을 다시 표시할 때의 위치: 마지막 위치에 두거나 앞으로 가져옵니다"
              },
              "role": "radio",
              "default": "away"
            }
          }
        }
      },
      {
        "type": "object",
        "meta": {
          "description": {
            "zh-Hans": "手柄",
            "zh-Hant": "手把",
            "ja": "コントローラー",
            "en": "Controllers",
            "ko": "컨트롤러"
          }
        },
        "dict": {
          "blockInput": {
            "type": "boolean",
            "meta": {
              "description": {
                "zh-Hans": "挡住游戏按键",
                "zh-Hant": "擋住遊戲按鍵",
                "ja": "ゲームへの入力を遮る",
                "en": "Block game input",
                "ko": "게임 입력 막기"
              },
              "hint": {
                "zh-Hans": "指着或抓着面板时，手柄按键不传给游戏",
                "zh-Hant": "指著或抓著面板時，手把按鍵不傳給遊戲",
                "ja": "パネルを指している、または掴んでいる間は、コントローラーの入力をゲームに渡しません",
                "en": "While pointing at or holding a panel, controller buttons are not passed to the game",
                "ko": "패널을 가리키거나 잡고 있는 동안 컨트롤러 입력을 게임에 전달하지 않습니다"
              },
              "default": true
            }
          },
          "grabDelay": {
            "type": "union",
            "list": [
              {
                "type": "const",
                "value": "0",
                "meta": {
                  "description": {
                    "zh-Hans": "无",
                    "zh-Hant": "無",
                    "ja": "なし",
                    "en": "None",
                    "ko": "없음"
                  }
                }
              },
              {
                "type": "const",
                "value": "0.15",
                "meta": {
                  "description": {
                    "zh-Hans": "0.15 秒",
                    "zh-Hant": "0.15 秒",
                    "ja": "0.15 秒",
                    "en": "0.15 s",
                    "ko": "0.15초"
                  }
                }
              },
              {
                "type": "const",
                "value": "0.4",
                "meta": {
                  "description": {
                    "zh-Hans": "0.4 秒",
                    "zh-Hant": "0.4 秒",
                    "ja": "0.4 秒",
                    "en": "0.4 s",
                    "ko": "0.4초"
                  }
                }
              }
            ],
            "meta": {
              "description": {
                "zh-Hans": "抓取延迟",
                "zh-Hant": "抓取延遲",
                "ja": "掴むまでの時間",
                "en": "Grab delay",
                "ko": "잡기 지연"
              },
              "hint": {
                "zh-Hans": "握把按住这么久面板才跟手，免得握东西时把面板带走",
                "zh-Hant": "握把按住這麼久面板才跟手，免得握東西時把面板帶走",
                "ja": "グリップをこの時間押し続けるとパネルが手に付いてきます。物を掴んだときにパネルが動くのを防ぎます",
                "en": "Hold the grip this long before the panel follows your hand, so gripping things does not drag panels away",
                "ko": "그립을 이만큼 누르고 있어야 패널이 손을 따라옵니다. 물건을 잡을 때 패널이 딸려 가지 않게 합니다"
              },
              "role": "radio",
              "default": "0.15"
            }
          },
          "stretch": {
            "type": "boolean",
            "meta": {
              "description": {
                "zh-Hans": "双手缩放",
                "zh-Hant": "雙手縮放",
                "ja": "両手で拡大縮小",
                "en": "Two-hand scaling",
                "ko": "양손 크기 조절"
              },
              "hint": {
                "zh-Hans": "两只手抓住同一块面板，拉开或合拢来改大小",
                "zh-Hant": "兩隻手抓住同一塊面板，拉開或合攏來改大小",
                "ja": "同じパネルを両手で掴み、広げたり狭めたりして大きさを変えます",
                "en": "Grab the same panel with both hands and pull apart or push together to resize it",
                "ko": "같은 패널을 양손으로 잡고 벌리거나 모아서 크기를 바꿉니다"
              },
              "default": true
            }
          },
          "snap": {
            "type": "boolean",
            "meta": {
              "description": {
                "zh-Hans": "松手时摆正",
                "zh-Hant": "放手時擺正",
                "ja": "離したとき傾きを直す",
                "en": "Straighten on release",
                "ko": "놓을 때 바로 세우기"
              },
              "hint": {
                "zh-Hans": "松手时面板只歪了一点就摆正",
                "zh-Hant": "放手時面板只歪了一點就擺正",
                "ja": "離したときパネルの傾きがわずかなら、まっすぐに直します",
                "en": "A panel released only slightly tilted is straightened",
                "ko": "놓을 때 패널이 조금만 기울어 있으면 바로 세웁니다"
              },
              "default": true
            }
          }
        }
      },
      {
        "type": "object",
        "meta": {
          "description": {
            "zh-Hans": "排查",
            "zh-Hant": "排查",
            "ja": "調査用",
            "en": "Troubleshooting",
            "ko": "문제 해결"
          }
        },
        "dict": {
          "hitTest": {
            "type": "union",
            "list": [
              {
                "type": "const",
                "value": "js",
                "meta": {
                  "description": {
                    "zh-Hans": "自己算",
                    "zh-Hant": "自己算",
                    "ja": "内部で計算",
                    "en": "Built in",
                    "ko": "직접 계산"
                  }
                }
              },
              {
                "type": "const",
                "value": "native",
                "meta": {
                  "description": {
                    "zh-Hans": "SteamVR 算",
                    "zh-Hant": "SteamVR 算",
                    "ja": "SteamVR で計算",
                    "en": "SteamVR",
                    "ko": "SteamVR 계산"
                  }
                }
              }
            ],
            "meta": {
              "description": {
                "zh-Hans": "指针落点的算法",
                "zh-Hant": "指標落點的演算法",
                "ja": "ポインター位置の計算",
                "en": "Pointer hit test",
                "ko": "포인터 위치 계산"
              },
              "hint": {
                "zh-Hans": "指针落点不对时换成 SteamVR 算试试；竖长的面板用 SteamVR 算时上下两端点不到",
                "zh-Hant": "指標落點不對時換成 SteamVR 算試試；豎長的面板用 SteamVR 算時上下兩端點不到",
                "ja": "ポインターの位置がずれるときは SteamVR での計算を試してください。縦長のパネルは SteamVR で計算すると上下の端が押せません",
                "en": "Try SteamVR if the pointer lands in the wrong place. With SteamVR, the top and bottom of tall panels cannot be reached",
                "ko": "포인터 위치가 어긋나면 SteamVR 계산을 써 보세요. 세로로 긴 패널은 SteamVR 계산에서 위아래 끝을 누를 수 없습니다"
              },
              "role": "radio",
              "default": "js"
            }
          },
          "hitCheck": {
            "type": "boolean",
            "meta": {
              "description": {
                "zh-Hans": "核对指针落点",
                "zh-Hant": "核對指標落點",
                "ja": "ポインター位置を照合",
                "en": "Check pointer hits",
                "ko": "포인터 위치 대조"
              },
              "hint": {
                "zh-Hans": "两种算法各算一次，落点差 2 像素以上时在运行日志里记一行",
                "zh-Hant": "兩種演算法各算一次，落點差 2 像素以上時在執行記錄裡記一行",
                "ja": "両方の方法で計算し、位置が 2 ピクセル以上ずれたら実行ログに 1 行記録します",
                "en": "Runs both hit tests and writes a log line when they differ by 2 pixels or more",
                "ko": "두 방법으로 각각 계산해 위치가 2픽셀 이상 다르면 실행 로그에 한 줄 기록합니다"
              },
              "default": false,
              "visible": {
                "hitTest": "js"
              }
            }
          },
          "textureSubmit": {
            "type": "union",
            "list": [
              {
                "type": "const",
                "value": "always",
                "meta": {
                  "description": {
                    "zh-Hans": "每帧都交",
                    "zh-Hant": "每幀都交",
                    "ja": "毎フレーム",
                    "en": "Every frame",
                    "ko": "매 프레임"
                  }
                }
              },
              {
                "type": "const",
                "value": "changed",
                "meta": {
                  "description": {
                    "zh-Hans": "画面变了才交",
                    "zh-Hant": "畫面變了才交",
                    "ja": "変化したときだけ",
                    "en": "Only when changed",
                    "ko": "바뀔 때만"
                  }
                }
              }
            ],
            "meta": {
              "description": {
                "zh-Hans": "画面交给 SteamVR 的方式",
                "zh-Hant": "畫面交給 SteamVR 的方式",
                "ja": "SteamVR への画面の渡し方",
                "en": "Texture submission",
                "ko": "SteamVR에 화면을 넘기는 방식"
              },
              "hint": {
                "zh-Hans": "画面变了才交可以在面板多时省一些开销；面板停在旧画面上时换回每帧都交",
                "zh-Hant": "畫面變了才交可以在面板多時省一些開銷；面板停在舊畫面上時換回每幀都交",
                "ja": "変化したときだけにすると、パネルが多いときの負荷を減らせます。パネルが古い画面のまま止まる場合は毎フレームに戻してください",
                "en": "Only when changed saves work when many panels are shown. Switch back to every frame if a panel gets stuck on an old image",
                "ko": "바뀔 때만으로 하면 패널이 많을 때 부하를 줄일 수 있습니다. 패널이 이전 화면에 멈추면 매 프레임으로 되돌리세요"
              },
              "role": "radio",
              "default": "always"
            }
          },
          "attach": {
            "type": "union",
            "list": [
              {
                "type": "const",
                "value": "native",
                "meta": {
                  "description": {
                    "zh-Hans": "SteamVR 带着走",
                    "zh-Hant": "SteamVR 帶著走",
                    "ja": "SteamVR に任せる",
                    "en": "SteamVR",
                    "ko": "SteamVR에 맡기기"
                  }
                }
              },
              {
                "type": "const",
                "value": "js",
                "meta": {
                  "description": {
                    "zh-Hans": "自己算",
                    "zh-Hant": "自己算",
                    "ja": "内部で計算",
                    "en": "Built in",
                    "ko": "직접 계산"
                  }
                }
              }
            ],
            "meta": {
              "description": {
                "zh-Hans": "附着面板的跟随方式",
                "zh-Hant": "附著面板的跟隨方式",
                "ja": "追従パネルの位置合わせ",
                "en": "Attached panel tracking",
                "ko": "부착 패널 따라가기 방식"
              },
              "hint": {
                "zh-Hans": "附着在头显或手柄上的面板怎么跟着走：交给 SteamVR，或者每帧自己算位置。面板跟不上、位置不对时换一种试试",
                "zh-Hant": "附著在頭顯或手把上的面板怎麼跟著走：交給 SteamVR，或者每幀自己算位置。面板跟不上、位置不對時換一種試試",
                "ja": "ヘッドセットやコントローラーに付けたパネルの追従方法：SteamVR に任せるか、毎フレーム内部で位置を計算します。パネルが遅れる、位置がずれるときは切り替えてみてください",
                "en": "How panels attached to the headset or a controller follow it: SteamVR moves them, or their position is computed every frame. Try the other one if a panel lags or sits in the wrong place",
                "ko": "헤드셋이나 컨트롤러에 붙인 패널이 따라가는 방식: SteamVR에 맡기거나 매 프레임 위치를 직접 계산합니다. 패널이 늦게 따라오거나 위치가 어긋나면 다른 쪽을 써 보세요"
              },
              "role": "radio",
              "default": "native"
            }
          }
        }
      }
    ]
  }
}
