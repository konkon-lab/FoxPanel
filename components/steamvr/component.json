{
  "id": "yanuo.steamvr",
  "kind": "service",
  "name": {
    "zh-Hans": "SteamVR",
    "zh-Hant": "SteamVR",
    "ja": "SteamVR",
    "en": "SteamVR",
    "ko": "SteamVR"
  },
  "description": {
    "zh-Hans": "在 SteamVR 中将面板显示为悬浮窗口：手柄指向并点击、握住移动、双手缩放，手柄按键收起和恢复",
    "zh-Hant": "在 SteamVR 中將面板顯示為懸浮視窗：手把指向並點擊、握住移動、雙手縮放，手把按鍵收起和恢復",
    "ja": "SteamVR でパネルをオーバーレイとして表示：コントローラーで指してクリック、握って移動、両手で拡大縮小、ボタンで収納と復元",
    "en": "Shows panels as overlays in SteamVR: point and click with controllers, grip to move, both hands to scale, a button to stow and restore",
    "ko": "SteamVR에서 패널을 오버레이로 표시: 컨트롤러로 가리켜 클릭, 잡아서 이동, 양손으로 크기 조절, 버튼으로 넣기와 복원"
  },
  "version": "1.0.14",
  "author": "yanuo",
  "license": "MIT",
  "provides": [
    "panels"
  ],
  "main": "main.js",
  "process": "own",
