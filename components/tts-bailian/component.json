{
  "id": "yanuo.tts-bailian",
  "kind": "output",
  "name": {
    "zh-Hans": "语音合成",
    "zh-Hant": "語音合成",
    "ja": "音声合成",
    "en": "Text to speech",
    "ko": "음성 합성"
  },
  "description": {
    "zh-Hans": "阿里云百炼 CosyVoice：发送时朗读译文，播放到选定设备",
    "zh-Hant": "阿里雲百煉 CosyVoice：傳送時朗讀譯文，播放到選定的裝置",
    "ja": "Alibaba Cloud Bailian CosyVoice：送信時に訳文を読み上げ、選択したデバイスで再生します",
    "en": "Alibaba Cloud Bailian CosyVoice: reads the translation aloud when sending, played on the selected device",
    "ko": "Alibaba Cloud Bailian CosyVoice: 보낼 때 번역문을 읽어 주고 선택한 장치로 재생합니다"
  },
  "version": "1.7.7",
  "author": "yanuo",
  "license": "MIT",
  "enabled": false,
  "main": "main.js",
  "page": "page.js",
  "requires": [
    "aliyun"
  ],
  "config": {
    "type": "object",
    "dict": {
      "model": {
        "type": "union",
        "list": [
          {
            "type": "const",
            "value": "cosyvoice-v3-flash",
            "meta": {
              "description": "cosyvoice-v3-flash"
            }
          },
          {
            "type": "const",
            "value": "cosyvoice-v3-plus",
            "meta": {
              "description": "cosyvoice-v3-plus"
            }
          },
          {
            "type": "const",
            "value": "cosyvoice-v3.5-flash",
            "meta": {
              "description": "cosyvoice-v3.5-flash"
            }
          },
          {
            "type": "const",
            "value": "cosyvoice-v3.5-plus",
            "meta": {
              "description": "cosyvoice-v3.5-plus"
            }
          }
        ],
        "meta": {
          "description": {
            "zh-Hans": "合成模型",
            "zh-Hant": "合成模型",
            "ja": "モデル",
            "en": "Model",
            "ko": "모델"
          },
          "default": "cosyvoice-v3-flash",
          "custom": true
        }
      },
      "voice": {
        "type": "union",
        "list": [
          {
            "type": "const",
            "value": "longhuhu_v3",
            "meta": {
              "description": "龙呼呼 · 天真烂漫女童"
            }
          },
          {
            "type": "const",
            "value": "longling_v3",
            "meta": {
              "description": "龙铃 · 稚气呆板女"
            }
          },
          {
            "type": "const",
            "value": "longxian_v3",
            "meta": {
              "description": "龙仙 · 豪放可爱女"
            }
          },
          {
            "type": "const",
            "value": "longdaiyu_v3",
            "meta": {
              "description": "龙黛玉 · 娇率才女音"
            }
          },
          {
            "type": "const",
            "value": "longfeifei_v3",
            "meta": {
              "description": "龙菲菲 · 甜美娇气女"
            }
          },
          {
            "type": "const",
            "value": "longhua_v3",
