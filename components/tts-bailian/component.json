          },
          {
            "type": "const",
            "value": "longwan_v3",
            "meta": {
              "description": "龙婉 · 细腻柔声女"
            }
          },
          {
            "type": "const",
            "value": "longyingxiao_v3",
            "meta": {
              "description": "龙应笑 · 清甜推销女"
            }
          },
          {
            "type": "const",
            "value": "longyumi_v3",
            "meta": {
              "description": "YUMI · 正经青年女"
            }
          },
          {
            "type": "const",
            "value": "longxiaochun_v3",
            "meta": {
              "description": "龙小淳 · 知性积极女"
            }
          },
          {
            "type": "const",
            "value": "loongriko_v3",
            "meta": {
              "description": "Riko · 二次元霓虹女(日语)"
            }
          },
          {
            "type": "const",
            "value": "loongyuuna_v3",
            "meta": {
              "description": "Yuuna · 日语女"
            }
          },
          {
            "type": "const",
            "value": "longanhuan",
            "meta": {
              "description": "龙安欢 · 欢脱元气女"
            }
          },
          {
            "type": "const",
            "value": "longanyang",
            "meta": {
              "description": "龙安洋 · 阳光大男孩"
            }
          }
        ],
        "meta": {
          "description": {
            "zh-Hans": "音色",
            "zh-Hant": "音色",
            "ja": "声",
            "en": "Voice",
            "ko": "음색"
          },
          "hint": {
            "zh-Hans": "朗读时使用的声音",
            "zh-Hant": "朗讀時使用的聲音",
            "ja": "読み上げに使う声",
            "en": "The voice used for reading aloud",
            "ko": "읽을 때 쓰는 목소리"
          },
          "default": "longhua_v3",
          "custom": true,
          "optionsFrom": {
            "setting": "customVoices",
            "value": "id",
            "label": "name",
            "sub": "model"
          }
        }
      },
      "customVoices": {
        "type": "array",
        "inner": {
          "type": "object",
          "dict": {
            "name": {
              "type": "string",
              "meta": {
                "description": {
                  "zh-Hans": "名称",
                  "zh-Hant": "名稱",
                  "ja": "名前",
                  "en": "Name",
                  "ko": "이름"
                }
              }
            },
            "id": {
              "type": "string",
              "meta": {
                "description": {
                  "zh-Hans": "音色 ID",
                  "zh-Hant": "音色 ID",
                  "ja": "声の ID",
                  "en": "Voice ID",
                  "ko": "음색 ID"
                }
              }
            },
            "model": {
              "type": "string",
              "meta": {
                "description": {
                  "zh-Hans": "模型(可选)",
                  "zh-Hant": "模型(選填)",
                  "ja": "モデル(任意)",
                  "en": "Model (optional)",
                  "ko": "모델(선택)"
                }
              }
            }
          }
        },
        "meta": {
          "description": {
            "zh-Hans": "自定义音色",
            "zh-Hant": "自訂音色",
            "ja": "カスタムの声",
            "en": "Custom voices",
            "ko": "사용자 음색"
          },
          "hint": {
            "zh-Hans": "通过声音复刻获得的音色 ID，填写后显示在音色下拉列表中；模型留空时使用所选的合成模型",
            "zh-Hant": "透過聲音複刻取得的音色 ID，填寫後顯示在音色下拉選單中；模型留空時使用所選的合成模型",
            "ja": "ボイスクローンで取得した声の ID です。入力すると声の一覧に表示されます。モデルが空欄の場合は、設定で選択したモデルを使用します",
            "en": "Voice IDs obtained from voice cloning. Once entered, they appear in the voice list. If the model is left empty, the model selected in the settings is used",
            "ko": "보이스 클로닝으로 얻은 음색 ID입니다. 입력하면 음색 목록에 표시됩니다. 모델을 비워 두면 설정에서 선택한 모델을 사용합니다"
          },
          "default": []
        }
      },
      "outputDevice": {
        "type": "string",
        "meta": {
          "description": {
            "zh-Hans": "播放设备",
            "zh-Hant": "播放裝置",
            "ja": "再生先",
            "en": "Playback device",
            "ko": "재생 장치"
          },
          "hint": {
            "zh-Hans": "声音输出设备",
            "zh-Hant": "聲音輸出裝置",
            "ja": "音声の出力デバイス",
            "en": "Audio output device",
            "ko": "소리 출력 장치"
          },
          "role": "audioOutput"
        }
      },
      "monitor": {
        "type": "boolean",
        "meta": {
          "description": {
            "zh-Hans": "本地监听",
            "zh-Hant": "本機監聽",
            "ja": "ローカルで聞く",
            "en": "Monitor locally",
            "ko": "로컬 모니터"
          },
          "hint": {
            "zh-Hans": "同时在监听设备上播放",
            "zh-Hant": "同時在監聽裝置上播放",
            "ja": "モニター先でも同時に再生します",
            "en": "Also plays on the monitor device",
            "ko": "모니터 장치에서도 동시에 재생합니다"
          },
          "default": true
        }
      },
      "monitorDevice": {
        "type": "string",
        "meta": {
          "description": {
            "zh-Hans": "监听设备",
            "zh-Hant": "監聽裝置",
            "ja": "モニター先",
            "en": "Monitor device",
            "ko": "모니터 장치"
          },
          "role": "audioOutput"
        }
      }
    }
  },
  "usage": {
    "currency": "CNY",
    "units": {
      "chars": {
        "zh-Hans": "字符",
        "zh-Hant": "字符",
        "ja": "文字",
        "en": "chars",
        "ko": "자"
      },
      "calls": {
        "zh-Hans": "句",
        "zh-Hant": "句",
        "ja": "文",
        "en": "sentences",
        "ko": "문장"
      }
    }
  },
  "dashboard": {
    "title": {
      "zh-Hans": "语音",
      "zh-Hant": "語音",
      "ja": "音声",
      "en": "Voice",
      "ko": "음성"
    },
    "keys": [
      "voice",
      "outputDevice",
      "monitor",
      "monitorDevice"
    ],
    "area": "right",
    "order": 20,
    "link": true,
    "grow": true
  }
}
