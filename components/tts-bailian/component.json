            }
          },
          {
            "type": "const",
            "value": "longanqin_v3",
            "meta": {
              "description": "龙安亲 · 亲和活泼女"
            }
          },
          {
            "type": "const",
            "value": "longanling_v3",
            "meta": {
              "description": "龙安灵 · 思维灵动女"
