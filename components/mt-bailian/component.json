              "description": "qwen-mt-flash"
            }
          },
          {
            "type": "const",
            "value": "qwen-mt-plus",
            "meta": {
              "description": "qwen-mt-plus"
            }
          },
          {
            "type": "const",
            "value": "qwen-mt-lite",
            "meta": {
              "description": "qwen-mt-lite"
            }
          },
